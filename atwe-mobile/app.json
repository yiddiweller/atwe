{
  "expo": {
    "name": "Atwe",
    "slug": "atwe",
    "scheme": "atwe",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atwe.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Atwe uses the camera for photos, video, stories, and QR scanning.",
        "NSPhotoLibraryUsageDescription": "Atwe lets you attach photos and video to posts, messages, and listings.",
        "NSMicrophoneUsageDescription": "Atwe uses the microphone for voice notes and calls.",
        "NSFaceIDUsageDescription": "Atwe uses Face ID to unlock the app and protected sections.",
        "NSLocationWhenInUseUsageDescription": "Atwe uses your location for near-me discovery and live location sharing.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Atwe does not track you across other apps or websites.",
        "NSContactsUsageDescription": "Atwe can find people you already know, only if you ask it to."
      },
      "associatedDomains": [
        "applinks:atwe.com",
        "applinks:www.atwe.com"
      ]
    },
    "android": {
      "package": "com.atwe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "atwe.com"
            },
            {
              "scheme": "https",
              "host": "www.atwe.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#0088FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 104
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Atwe uses the microphone for voice notes and calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://atwe.com",
      "eas": {
        "projectId": "e7cc019c-b415-4fa0-9f63-283aaf8d1ad6"
      }
    },
    "primaryColor": "#0088FF",
    "description": "The network built for business. Connect, message, hire, sell and grow, all in one place."
  }
}
