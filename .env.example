# ─── Core ───────────────────────────────────────────────
# Anthropic API key (required for chat)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Server port (optional, defaults to 3000)
PORT=3000

# Public base URL of the app — used to build links in emails (prod: https://atwe.com)
APP_URL=http://localhost:3000

# ─── Database (required for auth, history, projects, admin) ───
# On Railway, attach a PostgreSQL plugin and reference its DATABASE_URL.
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Force SSL on/off. Omit to auto-detect (on for remote, off for localhost).
# Socket-style URLs (host=/path) need this set explicitly.
# DB_SSL=true

# ─── Auth ───────────────────────────────────────────────
# Secret used to sign auth JWTs (required in production — long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Optional dedicated 256-bit key for the admin Vault's encryption at rest. If unset,
# a key is derived from JWT_SECRET (works out of the box). Set a separate long random
# value in production so rotating JWT_SECRET never affects vault decryption.
# DRIVE_KEY=another-long-random-string
# Email auto-granted admin dashboard access (also auto email-verified)
ADMIN_EMAIL=you@company.com
# Set to 'true' to block sign-in until the email is verified (default: off)
# REQUIRE_EMAIL_VERIFICATION=false
# Set to 'true' to require every staff/admin account to have 2FA before they can use
# the admin dashboard (default: off). Enabling 2FA happens in the app, so this can't
# lock out an owner who then just turns 2FA on.
# REQUIRE_ADMIN_2FA=false

# ─── Admin subdomain ────────────────────────────────────
# Host that serves the admin dashboard at its root (default admin.atwe.com)
ADMIN_HOST=admin.atwe.com

# ─── Email (optional — verification & password reset) ───
# If unset, emails are logged to the server console instead of sent.
# To enable real sending on atwe.com: set these in Railway, point MAIL_FROM at a
# verified atwe.com sender, and add the provider's SPF/DKIM DNS records.
#
# Recommended provider: Resend (free tier ~3,000/mo). After verifying the
# atwe.com domain in Resend, use these exact values — no mailbox needed, you can
# send from any address on the verified domain:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=<your Resend API key>
#   MAIL_FROM=Atwe <alerts@atwe.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
# The bit before <...> is the display name recipients see; the address is where
# it's sent from. e.g. "Atwe <alerts@atwe.com>" shows as just "Atwe".
# MAIL_FROM is the DEFAULT sender for all automated/system mail (verification,
# password reset, sign-in alerts, welcome, etc.) — set it to alerts@. team@ is
# NOT this value; team@ is used only for admin broadcasts (TEAM_FROM, below).
MAIL_FROM=Atwe <alerts@atwe.com>
# Optional: replies to automated mail (sent from a send-only From) go here —
# e.g. your human inbox, team@atwe.com.
MAIL_REPLY_TO=team@atwe.com
# Send-only display address the support/contact auto-reply is sent FROM
# (default support@atwe.com). NOT where the form lands — see SUPPORT_INBOX.
SUPPORT_EMAIL=support@atwe.com
# Where an in-app support/contact submission is actually DELIVERED. Defaults to
# MAIL_REPLY_TO, then TEAM_EMAIL. Set it to your real support inbox.
# SUPPORT_INBOX=team@atwe.com
# Per-category send-only From-addresses (replies go to MAIL_REPLY_TO). All default
# sensibly, so set these only to override the display name / address:
#   SUPPORT_FROM — help-center acknowledgements + admin replies
#   TEAM_FROM    — broadcast/marketing email sent from the admin dashboard
#   ALERTS_FROM  — account/security alerts (new sign-in, account changed/deleted)
SUPPORT_FROM=Atwe Support <support@atwe.com>
TEAM_EMAIL=team@atwe.com
TEAM_FROM=Atwe <team@atwe.com>
ALERTS_EMAIL=alerts@atwe.com
ALERTS_FROM=Atwe <alerts@atwe.com>

# ─── Geo-IP (optional — approximate location in Devices + login alerts) ───
# Resolves the login IP to "City, Country" for the Devices & sessions list and
# the new-sign-in alert email. Best-effort and degrades cleanly: on failure the
# Devices list just shows the raw IP. Defaults to a free, no-key HTTPS provider
# (ipwho.is). Override the endpoint ({ip} is substituted), or disable entirely.
# GEOIP_URL=https://ipwho.is/{ip}
# GEOIP_DISABLED=true

# ─── Billing (optional — Stripe Checkout for Pro) ───────
# If unset, "Upgrade to Pro" uses the demo instant-upgrade path.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One-time price for boosting a job post. If unset, "Boost" features the job
# instantly (demo) instead of charging.
STRIPE_BOOST_PRICE_ID=price_...
# One-time price for a promoted post ("Advertise this post"). If unset, promotion
# falls back to the demo instant-promote.
# STRIPE_PROMOTE_PRICE_ID=price_...

# ─── Atwe Ads (sponsored display ads) ───────────────────
# Price per day for a sponsored feed ad (advertiser request → admin review → pay).
# Charged via wallet balance / Stripe (metadata.type=ad) / demo grant. Default $5/day.
# AD_DAY_CENTS=500
# Nominal price recorded for a job boost in the company-revenue ledger on the demo
# (no-Stripe) path — real Stripe boosts use the actual charged amount. Default $10.
# JOB_BOOST_CENTS=1000

# ─── Web Push (optional — PWA notifications) ────────────
# When unset, push is simply disabled (notifications still arrive over SSE while
# a tab is open). Generate a key pair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@atwe.com

# ─── Wallet anti-fraud velocity caps (optional) ─────────
# Cumulative ceiling on money LEAVING a wallet (send / balance-paid order / tip),
# on top of the per-transaction $1–$2,000 limits and the per-IP rate limit.
# Rolling 24h + 7d windows; a debit that would breach either returns HTTP 429 with
# a clear "daily/weekly sending limit" message. Set to 0 to disable a window.
# Defaults: $5,000 / 24h and $15,000 / 7d (values in cents).
# WALLET_DAILY_CAP_CENTS=500000
# WALLET_WEEKLY_CAP_CENTS=1500000

# ─── Affiliate commissions (optional) ───────────────────
# Commission % paid to a promoter on a sale through their affiliate link, taken
# from the seller's wallet proceeds. Default 10 (range 0–50).
# AFFILIATE_RATE_PCT=10

# ─── GIF search (optional — Tenor) ──────────────────────
# When unset, the chat GIF tab shows "not set up" (stickers still work). Get a
# free key at https://developers.google.com/tenor.
TENOR_API_KEY=

# ─── Sales tax + carrier-rate shipping (optional) ───────
# All optional and degrade gracefully: with NONE set, checkout charges zero tax and
# the seller's existing flat shipping fee (unchanged). Layered cheapest→richest.
# Sales tax (first match wins): a real tax API, else a region→rate JSON map, else a
# single flat rate.
# TAX_API_URL=https://your-tax-provider/estimate
# TAX_API_KEY=
# SALES_TAX_RATES={"CA":0.0725,"NY":0.08,"US":0.06}
# SALES_TAX_RATE=0.08
# Shipping rates (first match wins): a real carrier-rate API, else a JSON array of
# flat options shown as selectable choices at checkout. Falls back to the seller fee.
# SHIPPING_API_URL=https://your-carrier-provider/rates
# SHIPPING_API_KEY=
# SHIPPING_RATES=[{"label":"Standard","amountCents":500,"days":"3-5"},{"label":"Express","amountCents":1500,"days":"1-2"}]

# ─── Real shipping labels (optional — Shippo) ────────────
# When unset, sellers still ship by entering a carrier + tracking number manually
# (POST /api/orders/:id/ship). With a key, a seller can instead get live multi-carrier
# rates for an order and buy an actual label (PDF) + tracking number in one flow — the
# label cost is debited from the seller's Atwe wallet balance. Get a key (test or live)
# at https://goshippo.com.
# SHIPPO_API_KEY=
# Optional: auto-detect delivery from carrier tracking instead of relying on someone
# tapping "Mark delivered" manually. Register a webhook for the 'track_updated' event
# in the Shippo dashboard pointing at:
#   https://your-app-url/api/webhooks/shippo?secret=<SHIPPO_WEBHOOK_SECRET>
# Shippo doesn't sign webhook payloads, so this shared secret is the only authenticity
# check — without it set, the webhook route accepts requests but does nothing.
# SHIPPO_WEBHOOK_SECRET=

# ─── Voice-note transcription (optional, speech-to-text) ─
# When unset, voice notes still send/play but the "Transcribe" action returns 503.
# Provider-agnostic: an OpenAI-Whisper-compatible endpoint (multipart file + model).
# STT_API_URL=https://api.openai.com/v1/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-1
# STT_LANGUAGE=        # optional ISO code to bias recognition (e.g. en)

# ─── $Cashtag market data (optional) ────────────────────
# Powers the price + chart on a $TICKER page. With nothing set it uses Yahoo
# Finance's free, no-key public endpoint (best-effort); any failure degrades to
# the in-app post stream (the cashtag page always works). Set FINANCE_PROVIDER=off
# to disable market data entirely, or use a keyed provider for reliability.
# FINANCE_PROVIDER=yahoo        # yahoo (default, no key) | finnhub | off
# FINNHUB_API_KEY=              # free tier at finnhub.io (used when FINANCE_PROVIDER=finnhub)
# TWELVEDATA_API_KEY=           # reserved for a future provider

# ─── Social sign-in (optional) ──────────────────────────
# Both degrade gracefully: with these unset, the matching button shows a
# "coming soon" notice and the /api/auth/* route returns 503.
#
# Google: one OAuth Client ID (Google Cloud console → Credentials → OAuth client,
# type "Web application"). Used by the frontend to start sign-in.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
#
# Apple (web): the Services ID from your Apple Developer account (App ID →
# Services ID with "Sign in with Apple" enabled; register the domain + a return
# URL of https://atwe.com/). A comma-separated list is accepted so a native iOS
# app's bundle id can be added later. No private key / client secret is needed —
# the server verifies Apple's id_token against Apple's public keys.
APPLE_CLIENT_ID=com.atwe.web
# Paste the contents of the domain-association file Apple gives you; the server
# serves it at /.well-known/apple-developer-domain-association.txt for verification.
APPLE_DOMAIN_ASSOCIATION=

# ─── Background flusher intervals (optional tuning, milliseconds) ───
# How often the background workers run. All have sensible defaults — set these
# only to tune throughput/latency. Scheduled messages (20s); recurring product
# subscriptions (1h); recurring/standing payments (1h); escrow auto-release (60s).
# SCHEDULE_FLUSH_MS=20000
# SUB_FLUSH_MS=3600000
# SCHEDPAY_FLUSH_MS=3600000
# ESCROW_FLUSH_MS=60000

# ─── Calls / WebRTC TURN (optional) ─────────────────────
# STUN is always on. Add a TURN provider so voice & video calls connect
# reliably across networks and firewalls. Priority: Cloudflare → static → free
# public relay fallback. With none set, calls still work via the public relay.
#
# Preferred: Cloudflare Realtime TURN (free 1 TB/mo). Create a TURN key in the
# Cloudflare dashboard (Realtime → TURN) and set these two — the server mints
# short-lived credentials automatically.
CLOUDFLARE_TURN_KEY_ID=your-cloudflare-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=your-cloudflare-turn-api-token
#
# Alternative: a static TURN server (metered.ca / Twilio / self-hosted coturn).
# TURN_URL accepts a comma-separated list of turn:/turns: URLs.
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# ── Chat link previews ─────────────────────────────────────
# Link previews (unfurl cards in chat) work with no config — the server fetches
# public pages directly. This flag disables the private-address (SSRF) guard so
# previews can be tested against localhost targets. Dev/test ONLY — never set
# it in production.
# LINK_PREVIEW_ALLOW_PRIVATE=1

# ═══════════════════════════════════════════════════════════
# The rest — all optional, all degrade cleanly
# Everything below is off by default. Nothing here stops the app running;
# each one just switches on a part of it. The admin dashboard's Setup tab
# shows which of these are live on your server right now.
# ═══════════════════════════════════════════════════════════

# ─── Photo & video storage (optional) ──────────────────────
# Without these, media is kept inside the database. That works, but it is
# capped small (~16MB per file) and gets heavier as you grow. Any S3-compatible
# provider — Cloudflare R2 and Backblaze B2 are both cheap — moves it out.
# CDN_URL is the public read address for the bucket; S3_PREFIX is an optional
# folder inside it.
# S3_BUCKET=atwe-media
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PREFIX=uploads/
# CDN_URL=https://media.atwe.com

# ─── Text messages (optional) ──────────────────────────────
# Texts for the two things worth interrupting someone about: a new sign-in,
# and money received. Without these they are written to the server log.
# Either a Twilio account, or any HTTP SMS gateway.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15551234567
# SMS_API_URL=https://your-sms-gateway.example/send
# SMS_API_KEY=your-sms-key

# ─── Making pictures (optional) ────────────────────────────
# Powers "generate a picture from words" and "tidy up this product photo".
# Provider-agnostic: any endpoint that takes a prompt and returns an image.
# Without it, both features say they are not set up.
# IMAGE_API_URL=https://your-image-api.example/v1/images
# IMAGE_API_KEY=your-image-key
# IMAGE_MODEL=your-model-name
# IMAGE_SIZE=1024x1024

# ─── GIF search (optional) ─────────────────────────────────
# TENOR_API_KEY is the primary (free from Google). GIPHY_API_KEY is an
# alternative. Without either, the GIF tab says so; stickers and emoji
# are unaffected.
# GIPHY_API_KEY=your-giphy-key

# ─── Sign in with Apple (optional) ─────────────────────────
# APPLE_CLIENT_ID is the Services ID (documented above). APPLE_APP_ID is the
# native iOS bundle identifier, needed only for the phone app's own sign-in.
# APPLE_APP_ID=com.atwe.app

# ─── Prices and limits you may want to change ──────────────
# All have sensible defaults; set one only to override it.
# What a business pays for a featured spot in the directory, per day (cents).
# DIRECTORY_FEATURE_DAY_CENTS=300
# A cash-out at or above this (cents) waits for a human instead of going
# straight to the bank. Fraud precaution.
# CASHOUT_REVIEW_CENTS=100000
# How long a brand-new account is stopped from posting links. Spam control.
# PROBATION_HOURS=48
# Currencies the picker offers, as JSON. Display only — charges stay in USD.
# Without it, members only ever see US dollars.
# FX_RATES={"EUR":0.92,"GBP":0.79,"CAD":1.36}
# The handle Atwe posts announcements from. Created automatically on first boot.
# ATWE_OFFICIAL_USERNAME=atwe

# ─── Background job timing (optional) ──────────────────────
# Every one of these already has a sensible default and none needs setting.
# They exist so a busy deployment can tune how often each background job runs
# (milliseconds). The admin Site tab shows each job's health and last run.
# CARTREC_FLUSH_MS=300000       # abandoned-cart nudges
# AUCTION_FLUSH_MS=60000        # auction endings
# BCAST_FLUSH_MS=60000          # scheduled broadcasts
# WEBHOOK_FLUSH_MS=30000        # outgoing seller webhooks
# AI_TASK_FLUSH_MS=60000        # queued AI jobs
# ANOMALY_FLUSH_MS=900000       # fraud/anomaly scanning
# CRM_FLUSH_MS=3600000          # CRM follow-ups
# LEADALERT_FLUSH_MS=900000     # lead alerts
# RINV_FLUSH_MS=3600000         # recurring invoices
# POTSAVE_FLUSH_MS=3600000      # automatic pot saving
# BRIEF_FLUSH_MS=3600000        # the owner's daily brief
# WEEK_SUMMARY_MS=86400000      # weekly summaries

# ─── Multi-instance (optional) ─────────────────────────────
# Set only if you run more than one server process behind a load balancer, so
# realtime events reach members connected to a different instance.
# CLUSTER_MODE=1
